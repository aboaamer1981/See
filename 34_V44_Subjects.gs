var V44_SUBJECT_RULES_RX_ = null;
function subjectNormV44_(s){
  s=String(s==null?'':s);
  s=s.replace(/[\u064B-\u0652\u0640\u200c-\u200f\u202a-\u202e\u00a0]/g,'');
  s=s.replace(/[أإآٱ]/g,'ا').replace(/ة/g,'ه').replace(/ى/g,'ي').replace(/ی/g,'ي').replace(/ک/g,'ك').replace(/ھ/g,'ه').replace(/ؤ/g,'و').replace(/ئ/g,'ي');
  return s.replace(/\s+/g,' ').trim();
}
function subjectCanonV44_(raw){
  var t=String(raw==null?'':raw).trim(); if(!t) return '';
  if(!V44_SUBJECT_RULES_RX_) V44_SUBJECT_RULES_RX_=V44_SUBJECT_RULES.map(function(r){return [new RegExp(r[0]),r[1]];});
  var s=subjectNormV44_(t);
  for(var i=0;i<V44_SUBJECT_RULES_RX_.length;i++) if(V44_SUBJECT_RULES_RX_[i][0].test(s)) return V44_SUBJECT_RULES_RX_[i][1]||'';
  return t;
}
