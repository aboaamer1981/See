/** أعمدة يضيفها النظام بنفسه عند أول استخدام — لا تُعد ناقصة ولا إضافية. */
var V53_AUTO_COLS = {"22_خط_السير": ["عناصر_اليوم"], "08_الماليات": ["تفصيل_المدارس"], "18_بيانات_المدارس": ["رابط_اللوكيشن"]};
/** أوراق أُحذفت في V5.3 (لا يستخدمها الكود). إن وُجدت في الشيت الحي تظهر في الفحص «قديمة — يمكن حذفها». */
var V53_RETIRED_SHEETS = ["03_المدارس", "00_اقرأ_أولاً", "02_الحصة_تفاصيل", "مصدر_حصة_معلمي الحصة 2027", "مصدر_حصة_معلمي الحصة 2026", "مصدر_حصة_الإعدادات", "مصدر_حصة_بيانات المراحل", "R_قواعد_التعارضات", "17_قواعد_الاستحقاقات", "25_مطابقة_المدارس_الفعلية", "R_قوائم_التحقق", "R_تصنيف_المدارس", "R_تغييرات_الحالة", "14_ملخص_التعارضات", "13_مراجعة_التعارضات", "10_سجل_الاستيراد", "R_أنواع_الغياب", "R_قواعد_الحافز", "مصدر59_مرفقات معلمي الحصة 2027", "مصدر59_حصر المدارس", "مصدر59_تدريب معلمي الحصة", "مصدر59_توزيع تدريب معلمي الحصة", "مصدر59_قواعد النظام", "مصدر59_مرجع أنصبة المواد", "مصدر59_مواد موقف العجز والزيادة", "مصدر59_عجز المدارس", "مصدر59_الأمن والسلامة", "مصدر59_بيانات المراحل", "مصدر59_التعليم المجتمعي", "مصدر59_قوائم المدارس", "مصدر59_سجل التقارير"];
/** أوراق مراجعة مؤقتة (قرارات لم تُحسم بعد) — لا تُحذف تلقائيًا. */
var V53_REVIEW_SHEETS = ["مراجعة_Master_2026", "مراجعة_جهة_العمل"];

/** فحص البنية — قراءة فقط: يقارن سطر العناوين في كل ورقة بالبنية المعتمدة. */
function v53SchemaCheck_(){
  var ss = personnelSS_(), live = {}, out = [], sum = {ok: 0, warn: 0, bad: 0};
  ss.getSheets().forEach(function(sh){ live[sh.getName()] = sh; });
  Object.keys(V53_SCHEMA).forEach(function(name){
    var exp = V53_SCHEMA[name], used = {}; (V53_CODE_USED[name] || []).forEach(function(c){ used[c] = 1; });
    var sh = live[name], r = {sheet: name, level: 'ok', missingUsed: [], missing: [], extra: [], dup: [], rows: 0, cols: 0};
    if (!sh) { r.level = (V53_CODE_USED[name] || []).length ? 'bad' : 'warn'; r.absent = true; out.push(r); sum[r.level]++; return; }
    var lc = sh.getLastColumn(), h = lc ? sh.getRange(1, 1, 1, lc).getDisplayValues()[0].map(function(x){ return String(x).trim(); }) : [], seen = {}, have = {};
    r.rows = Math.max(0, sh.getLastRow() - 1); r.cols = lc;
    h.forEach(function(x){ if (!x) return; if (seen[x]) r.dup.push(x); seen[x] = 1; have[x] = 1; });
    exp.forEach(function(c){ if (!have[c]) (used[c] ? r.missingUsed : r.missing).push(c); });
    var expSet = {}; exp.concat(V53_AUTO_COLS[name] || []).forEach(function(c){ expSet[c] = 1; });
    Object.keys(have).forEach(function(c){ if (!expSet[c]) r.extra.push(c); });
    if (r.missingUsed.length || r.dup.length) r.level = 'bad'; else if (r.missing.length) r.level = 'warn';
    out.push(r); sum[r.level]++;
  });
  var retired = [], unknown = [], review = [], ret = {}, rev = {};
  V53_RETIRED_SHEETS.forEach(function(n){ ret[n] = 1; }); V53_REVIEW_SHEETS.forEach(function(n){ rev[n] = 1; });
  Object.keys(live).forEach(function(n){ if (V53_SCHEMA[n]) return; var rc = Math.max(0, live[n].getLastRow() - 1); if (ret[n]) retired.push({sheet: n, rows: rc}); else if (rev[n]) review.push({sheet: n, rows: rc}); else unknown.push({sheet: n, rows: rc}); });
  return {success: true, version: V53_SCHEMA_VERSION, summary: sum, sheets: out, retired: retired, review: review, unknown: unknown, checkedAt: new Date().toISOString()};
}
function adminSchemaCheckV53(token){ v35Admin_(token); return v53SchemaCheck_(); }
/** من المحرر (المالك فقط): نفس الفحص في السجل. */
function schemaCheckV53(){ v36OwnerOnly_(); var r = v53SchemaCheck_(); Logger.log(JSON.stringify(r.summary)); r.sheets.filter(function(x){ return x.level !== 'ok'; }).forEach(function(x){ Logger.log(x.level + ' ' + x.sheet + (x.absent ? ' (غير موجودة)' : '') + ' ناقص_مستخدم=' + x.missingUsed.join('،') + ' ناقص=' + x.missing.join('،') + ' مكرر=' + x.dup.join('،')); }); return r.summary; }
/** حذف الأوراق القديمة (قائمة V53_RETIRED_SHEETS فقط) من الشيت الحي — للأدمن بعد تأكيد. لا يمس أي ورقة أخرى. */
function adminDropRetiredSheetsV53(token, confirmText){
  v35Admin_(token); if (String(confirmText || '').trim() !== 'حذف') throw new Error('للتأكيد اكتب كلمة: حذف');
  var ss = personnelSS_(), done = [], uni = null;
  if (ss.getSheetByName('03_المدارس')) uni = v53UnifySchools_(true);   // انقل أي قيمة ناقصة من 03 إلى 18 قبل حذف 03
  var lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    V53_RETIRED_SHEETS.forEach(function(n){ var sh = ss.getSheetByName(n); if (sh && ss.getSheets().length > 1) { v50A_(ss.deleteSheet(sh)); done.push(n); } });
  } finally { try { lock.releaseLock(); } catch (e) {} }
  v50Invalidate_();
  return {success: true, message: (uni ? uni.message + ' — ' : '') + (done.length ? 'حُذفت ' + done.length + ' ورقة قديمة.' : 'لا توجد أوراق قديمة في الشيت.'), deleted: done};
}

/** V5.3.1 — توحيد المدارس: 18_بيانات_المدارس هي المصدر الوحيد. تنقل من 03_المدارس أي قيمة ناقصة في 18
 *  (خانة فارغة، أو رقم هاتف فقد الصفر الأول) وأي مدرسة غير موجودة في 18. لا تمسح أي قيمة موجودة في 18. */
var V53_SCHOOL_MAP = {'كود_المدرسة': 'كود_هيئة_الأبنية'};
function v53UnifySchools_(apply){
  var ss = personnelSS_(), a = ss.getSheetByName('03_المدارس'), b = ss.getSheetByName('18_بيانات_المدارس');
  if (!a) return {success: true, message: 'لا توجد ورقة 03_المدارس — المدارس موحدة بالفعل.', filled: 0, added: 0, changes: []};
  if (!b) throw new Error('ورقة 18_بيانات_المدارس غير موجودة.');
  var av = a.getDataRange().getDisplayValues(), bv = b.getDataRange().getDisplayValues(), ah = av[0].map(String), bh = bv[0].map(String);
  var ai = {}, bi = {}; ah.forEach(function(h, i){ if (h) ai[h] = i; }); bh.forEach(function(h, i){ if (h) bi[h] = i; });
  var rowOf = {}; for (var r = 1; r < bv.length; r++) if (bv[r][bi.schoolId]) rowOf[bv[r][bi.schoolId]] = r;
  var cols = Object.keys(ai).filter(function(h){ return h !== 'schoolId' && bi[V53_SCHOOL_MAP[h] || h] != null; });
  var changes = [], adds = [], filled = 0;
  for (var i = 1; i < av.length; i++) {
    var sid = String(av[i][ai.schoolId] || '').trim(); if (!sid) continue;
    var rr = rowOf[sid];
    if (rr == null) { var row = new Array(bh.length).fill(''); row[bi.schoolId] = sid; cols.forEach(function(h){ row[bi[V53_SCHOOL_MAP[h] || h]] = av[i][ai[h]]; }); if (bi['حالة_البيانات'] != null) row[bi['حالة_البيانات']] = 'منقول من 03_المدارس'; adds.push(row); changes.push([av[i][ai['اسم_المدرسة']], 'إضافة مدرسة', '']); continue; }
    cols.forEach(function(h){
      var src = String(av[i][ai[h]] || '').trim(), c = bi[V53_SCHOOL_MAP[h] || h], cur = String(bv[rr][c] || '').trim();
      if (!src || src === cur) return;
      var lostZero = /^0\d{9,10}$/.test(src) && cur === src.slice(1);
      if (cur && !lostZero) return;
      changes.push([bv[rr][bi['اسم_المدرسة']], V53_SCHOOL_MAP[h] || h, src]); filled++;
      if (apply) { var cell = b.getRange(rr + 1, c + 1); if (/^0\d+$/.test(src)) cell.setNumberFormat('@'); v50A_(cell.setValue(src)); }
    });
  }
  if (apply && adds.length) v50A_(b.getRange(b.getLastRow() + 1, 1, adds.length, bh.length).setValues(adds));
  if (apply) v50Invalidate_();
  return {success: true, message: (apply ? 'توحيد المدارس: ' : 'معاينة توحيد المدارس: ') + filled + ' خانة تُستكمل في 18 من 03، و' + adds.length + ' مدرسة تُضاف.', filled: filled, added: adds.length, changes: changes.slice(0, 200)};
}
function adminUnifySchoolsV53(token, apply){ v35Admin_(token); return v53UnifySchools_(!!apply); }
